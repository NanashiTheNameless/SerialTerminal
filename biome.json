{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"files": {
		"includes": [
			"**",
			"!**/build",
			"!**/dist",
			"!**/node_modules",
			"!**/SerialTerminalOffline-*",
			"!**/.yarn/**",
			"!**/.pnp.cjs",
			"!**/.pnp.loader.mjs"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noUnusedImports": "off",
				"noUnusedVariables": "warn"
			}
		}
	}
}
